{
  "name": "pro-site-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "payload": "payload",
    "migrate": "payload migrate --config payload.config.ts",
    "migrate:create": "payload migrate:create --config payload.config.ts",
    "db:backup": "node ./scripts/db-backup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "@vercel/analytics": "^2.0.1",
    "graphql": "^16.8.1",
    "gray-matter": "^4.0.3",
    "next": "^16.4.4",
    "next-themes": "^0.4.6",
    "payload": "3.91.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "undici": "7.30.1",
    "happy-dom": "21.0.4"
  }
